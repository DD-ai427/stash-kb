{
  "id": "stash-xiaohongshu",
  "name": "Stash — 小红书",
  "behavior": "create",
  "noteNameFormat": "{{date|date:\"YYYY-MM-DD\"}}-{{title}}",
  "path": "inbox",
  "noteContentFormat": "![]({{image}})\n\n{{selectorHtml:.swiper-wrapper}}\n\n{{selector:#detail-desc}}\n\n## 评论\n\n{{selector:.comments-el}}",
  "context": "",
  "properties": [
    {
      "id": "stash-xhs-title",
      "name": "title",
      "value": "{{title}}"
    },
    {
      "id": "stash-xhs-source",
      "name": "source",
      "value": "{{url}}"
    },
    {
      "id": "stash-xhs-platform",
      "name": "platform",
      "value": "xiaohongshu"
    },
    {
      "id": "stash-xhs-clipped",
      "name": "clipped_at",
      "value": "{{date|date:\"YYYY-MM-DD HH:mm\"}}"
    },
    {
      "id": "stash-xhs-status",
      "name": "status",
      "value": "unprocessed"
    },
    {
      "id": "stash-xhs-tags",
      "name": "tags",
      "value": ""
    }
  ],
  "triggers": [
    "xiaohongshu.com",
    "xhslink.com"
  ]
}